generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  COMPLETE
  CANCELLED
}

enum DeliverableType {
  POST
  REEL
  STORY
  VIDEO
  LIVESTREAM
  OTHER
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  LIVE
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Brand {
  id           String     @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  notes        String?
  createdAt    DateTime   @default(now())
  campaigns    Campaign[]
  invoices     Invoice[]
  accountManagerAssignments AccountManagerAssignment[]
}

model Creator {
  id                    String                     @id @default(cuid())
  name                  String
  handle                String?
  platform              String?
  email                 String?
  rateCard              String?
  notes                 String?
  connectToken          String?                    @unique
  instagramAccountId    String?
  instagramAccessToken  String?
  tokenExpiresAt        DateTime?
  instagramConnectedAt  DateTime?
  mountliftScore        Float?
  engagementScore       Float?
  audienceScore         Float?
  contentScore          Float?
  consistencyScore      Float?
  profileScore          Float?
  scoreCalculatedAt     DateTime?
  privateInsights       Json?
  createdAt             DateTime                   @default(now())
  deliverables          Deliverable[]
  insights              CreatorInsight[]
  managerAssignments    CreatorManagerAssignment[]
  posts                 Post[]
}

model CreatorManagerAssignment {
  id          String   @id @default(cuid())
  clerkUserId String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  createdAt   DateTime @default(now())

  @@unique([clerkUserId, creatorId])
  @@index([clerkUserId])
}

model AccountManagerAssignment {
  id          String   @id @default(cuid())
  clerkUserId String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  createdAt   DateTime @default(now())

  @@unique([clerkUserId, brandId])
  @@index([clerkUserId])
}

model ManagerUpdate {
  id                String   @id @default(cuid())
  targetClerkUserId String
  title             String
  body              String
  createdByClerkId  String
  createdAt         DateTime @default(now())

  @@index([targetClerkUserId, createdAt])
}

model CreatorInsight {
  id                   String   @id @default(cuid())
  creator              Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId            String
  avgViews             Float?
  medianViews          Float?
  avgLikes             Float?
  avgComments          Float?
  engagementRate       Float?
  consistencyLabel     String?
  postingFrequencyDays Float?
  viewToFollowerRatio  Float?

  followerCount        Float?
  followingCount       Float?
  postCount            Float?
  verified             Boolean?
  profileUrl           String?
  overallScore         Float?
  engagementScore      Float?
  audienceScore        Float?
  contentQualityScore  Float?
  consistencyScore     Float?
  audienceData         Json?
  topLocations         Json?
  interests            Json?
  ageDistribution      Json?
  genderDistribution   Json?
  source               String?
  sourceVersion        String?

  raw                  Json
  createdAt            DateTime @default(now())

  @@index([creatorId, createdAt])
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  budget       Decimal        @default(0) @db.Decimal(12, 2)
  status       CampaignStatus @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  deliverables Deliverable[]
  invoices     Invoice[]
  messages     CampaignMessage[]
  messageReads CampaignMessageRead[]
}

model CampaignMessage {
  id             String   @id @default(cuid())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String
  senderClerkId  String
  body           String
  createdAt      DateTime @default(now())

  @@index([campaignId, createdAt])
}

model CampaignMessageRead {
  id          String   @id @default(cuid())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  clerkUserId String
  lastReadAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, clerkUserId])
  @@index([clerkUserId])
}

model Deliverable {
  id          String            @id @default(cuid())
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  creator     Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  type        DeliverableType   @default(POST)
  agreedRate  Decimal           @default(0) @db.Decimal(12, 2)
  status      DeliverableStatus @default(PLANNED)
  dueDate     DateTime?
  liveUrl     String?
  createdAt   DateTime          @default(now())
  payouts     Payout[]
}

model Payout {
  id            String       @id @default(cuid())
  deliverable   Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  deliverableId String
  amount        Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
}

model Invoice {
  id         String        @id @default(cuid())
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId    String
  campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  amount     Decimal       @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  issuedAt   DateTime      @default(now())
  dueAt      DateTime?
  paidAt     DateTime?
}

enum Platform {
  INSTAGRAM
  TIKTOK
}

enum ContentFormat {
  REEL
  POST
  STORY
  VIDEO
  CAROUSEL
}

model Post {
  id           String            @id @default(cuid())
  creator      Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId    String
  platform     Platform
  format       ContentFormat
  caption      String?
  url          String?
  postedAt     DateTime
  tags         ContentTag[]
  metrics      PostMetrics?
  demographics PostDemographics?
  createdAt    DateTime          @default(now())

  @@index([creatorId, postedAt])
}

model PostMetrics {
  id          String   @id @default(cuid())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String   @unique
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  reach       Int?
  impressions Int?
  enteredAt   DateTime @default(now())
}

model PostDemographics {
  id           String @id @default(cuid())
  post         Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String @unique
  ageRanges    Json   // { "13-17": 4.2, "18-24": 38.1, "25-34": 35.2, ... } percentages
  genderSplit  Json   // { "male": 41.2, "female": 57.1, "other": 1.7 }
  topLocations Json   // [{ "location": "Mumbai", "percentage": 12.4 }, ...]
}

model ContentTag {
  id    String @id @default(cuid())
  name  String @unique
  posts Post[]
}

